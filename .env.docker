APP_NAME=SeatGuard
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=seatguard
DB_USERNAME=seatguard_app
DB_PASSWORD=seatguard_app
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=3000

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@seatguard.dev"

OCTANE_SERVER=frankenphp

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=seatguard
KEYCLOAK_CLIENT_ID=seatguard-web
